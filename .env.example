# Required. Make a key at https://decisionnode.com/console/keys
DECISIONNODE_API_KEY=

# Optional. The models in order: flash,moe (default), moe, or flash
ROUTER_MODELS=

# Optional. The confidence an answer needs to be final, 0 to 1 (default 0.7)
ROUTER_THRESHOLD=

# Optional. Email delivery through Resend
RESEND_API_KEY=
RESEND_FROM=
